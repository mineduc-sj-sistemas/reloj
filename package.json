{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "reloj-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"cd backend && php artisan serve --host=0.0.0.0 --port=8000\" \"cd frontend && npx vite\"",
        "dev:backend": "cd backend && php artisan serve --host=0.0.0.0 --port=8000",
        "dev:frontend": "cd frontend && npx vite",
        "build": "cd frontend && npm run build"
    },
    "devDependencies": {
        "concurrently": "^10.0.5"
    }
}
